{
  "name": "tribal-kava-lounge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "npm run build && node scripts/site-check.mjs && node scripts/analytics-check.mjs && npm run test:api",
    "test:api": "npm --prefix api test",
    "deploy:azure": "zsh scripts/deploy-azure.sh",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "serve": "npx --yes @azure/static-web-apps-cli start dist --api-location api"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.9"
  }
}
